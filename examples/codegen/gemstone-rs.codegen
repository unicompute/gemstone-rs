# gemstone-rs codegen config
# Empty dictionary means resolve through the active user's symbol list.
output = generated/gemstone_wrappers.rs
class = Object
method = Object>>printString
method = Object>>class

# Use Dictionary:ClassName when a class must be resolved from a specific dictionary.
# class = UserGlobals:OkzBooking
# method = UserGlobals:OkzBooking>>findById:
