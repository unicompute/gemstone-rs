{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unicompute/gemstone-rs/raw/main/schemas/gemstone-rs.py-native-samples.schema.json",
  "title": "gemstone-rs py-native Samples Output",
  "description": "Machine-readable output from gemstone-rs py-native samples --json for gemstone-py-native value/error translation tests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "values", "errors"],
  "properties": {
    "contractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "error"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "nil"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "const": "smallInt"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "const": "char"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "enum": ["string", "symbol"]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "raw"],
          "properties": {
            "kind": {
              "const": "oop"
            },
            "raw": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {
          "enum": [
            "gci",
            "missingEnvironment",
            "missingConfig",
            "nul",
            "notLoggedIn",
            "gemStone",
            "illegalOop",
            "unexpectedType",
            "mapping",
            "workerStopped",
            "workerPanicked",
            "negativeSize",
            "argumentCountTooLarge"
          ]
        },
        "message": {
          "type": "string"
        },
        "gemstoneNumber": {
          "type": "integer"
        },
        "fatal": {
          "type": "boolean"
        },
        "operation": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        }
      }
    }
  }
}
