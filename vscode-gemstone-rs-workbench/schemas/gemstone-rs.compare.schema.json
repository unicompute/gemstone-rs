{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unicompute/gemstone-rs/raw/main/schemas/gemstone-rs.compare.schema.json",
  "title": "gemstone-rs Compare Output",
  "description": "Machine-readable output from gemstone-rs compare ... --json for CI, release planning, docs, and editor integrations.",
  "oneOf": [
    {
      "$ref": "#/$defs/singleSummary"
    },
    {
      "$ref": "#/$defs/singleStatus"
    },
    {
      "$ref": "#/$defs/singleScorecard"
    },
    {
      "$ref": "#/$defs/singleParity"
    },
    {
      "$ref": "#/$defs/singleGaps"
    },
    {
      "$ref": "#/$defs/singleNext"
    },
    {
      "$ref": "#/$defs/singleTotals"
    },
    {
      "$ref": "#/$defs/singleBatches"
    },
    {
      "$ref": "#/$defs/allSummary"
    },
    {
      "$ref": "#/$defs/allStatus"
    },
    {
      "$ref": "#/$defs/allScorecard"
    },
    {
      "$ref": "#/$defs/allParity"
    },
    {
      "$ref": "#/$defs/allGaps"
    },
    {
      "$ref": "#/$defs/allNext"
    },
    {
      "$ref": "#/$defs/allTotals"
    },
    {
      "$ref": "#/$defs/allBatches"
    }
  ],
  "$defs": {
    "comparisonName": {
      "type": "string",
      "enum": ["gemstone-py", "gemstone-js"]
    },
    "singleSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "view", "rows"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "view": {
          "const": "summary"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/summaryRow"
          }
        }
      }
    },
    "singleStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "view",
        "answer",
        "remaining",
        "parity",
        "nextBatch",
        "topGap",
        "commands"
      ],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "view": {
          "const": "status"
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "remaining": {
          "$ref": "#/$defs/remaining"
        },
        "parity": {
          "$ref": "#/$defs/parityOverall"
        },
        "nextBatch": {
          "$ref": "#/$defs/batch"
        },
        "topGap": {
          "$ref": "#/$defs/genericGap"
        },
        "commands": {
          "$ref": "#/$defs/statusCommands"
        }
      }
    },
    "singleScorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "view",
        "answer",
        "gemstonePyUseWhen",
        "projectUseWhen",
        "gemstonePyStrengths",
        "projectStrengths",
        "remaining",
        "nextBatch",
        "topGap"
      ],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "view": {
          "const": "scorecard"
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "gemstonePyUseWhen": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "projectUseWhen": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "gemstonePyStrengths": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "projectStrengths": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "remaining": {
          "$ref": "#/$defs/remaining"
        },
        "nextBatch": {
          "$ref": "#/$defs/batch"
        },
        "topGap": {
          "$ref": "#/$defs/genericGap"
        }
      }
    },
    "singleParity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "view", "project", "overall", "rows"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "view": {
          "const": "parity"
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "overall": {
          "$ref": "#/$defs/parityOverall"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/parityRow"
          }
        }
      }
    },
    "singleGaps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "view", "gaps"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "view": {
          "const": "gaps"
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comparisonGap"
          }
        }
      }
    },
    "singleNext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "view", "batch", "gap"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "view": {
          "const": "next"
        },
        "batch": {
          "$ref": "#/$defs/batch"
        },
        "gap": {
          "$ref": "#/$defs/genericGap"
        }
      }
    },
    "singleTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "view", "totalBatches", "hoursMin", "hoursMax"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "view": {
          "const": "totals"
        },
        "totalBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMin": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMax": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "singleBatches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "view", "totalBatches", "hoursMin", "hoursMax", "batches"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "view": {
          "const": "batches"
        },
        "totalBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMin": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMax": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "batches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/batch"
          }
        }
      }
    },
    "allSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "view", "comparisons"],
      "properties": {
        "comparison": {
          "const": "all"
        },
        "view": {
          "const": "summary"
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/summaryEntry"
          }
        }
      }
    },
    "allStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "view",
        "totalBatches",
        "hoursMin",
        "hoursMax",
        "comparisons"
      ],
      "properties": {
        "comparison": {
          "const": "all"
        },
        "view": {
          "const": "status"
        },
        "totalBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMin": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMax": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/statusEntry"
          }
        }
      }
    },
    "allScorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "view",
        "totalBatches",
        "hoursMin",
        "hoursMax",
        "comparisons"
      ],
      "properties": {
        "comparison": {
          "const": "all"
        },
        "view": {
          "const": "scorecard"
        },
        "totalBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMin": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMax": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scorecardEntry"
          }
        }
      }
    },
    "allParity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "view", "comparisons"],
      "properties": {
        "comparison": {
          "const": "all"
        },
        "view": {
          "const": "parity"
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/parityEntry"
          }
        }
      }
    },
    "allGaps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "view", "comparisons"],
      "properties": {
        "comparison": {
          "const": "all"
        },
        "view": {
          "const": "gaps"
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gapEntry"
          }
        }
      }
    },
    "allNext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "view", "comparisons"],
      "properties": {
        "comparison": {
          "const": "all"
        },
        "view": {
          "const": "next"
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nextEntry"
          }
        }
      }
    },
    "allTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "view",
        "totalBatches",
        "hoursMin",
        "hoursMax",
        "comparisons"
      ],
      "properties": {
        "comparison": {
          "const": "all"
        },
        "view": {
          "const": "totals"
        },
        "totalBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMin": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMax": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/totalsEntry"
          }
        }
      }
    },
    "allBatches": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "view",
        "totalBatches",
        "hoursMin",
        "hoursMax",
        "comparisons"
      ],
      "properties": {
        "comparison": {
          "const": "all"
        },
        "view": {
          "const": "batches"
        },
        "totalBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMin": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMax": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/batchEntry"
          }
        }
      }
    },
    "summaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "rows"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/summaryRow"
          }
        }
      }
    },
    "statusEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "answer",
        "remaining",
        "parity",
        "nextBatch",
        "topGap",
        "commands"
      ],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "remaining": {
          "$ref": "#/$defs/remaining"
        },
        "parity": {
          "$ref": "#/$defs/parityOverall"
        },
        "nextBatch": {
          "$ref": "#/$defs/batch"
        },
        "topGap": {
          "$ref": "#/$defs/genericGap"
        },
        "commands": {
          "$ref": "#/$defs/statusCommands"
        }
      }
    },
    "scorecardEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "answer",
        "gemstonePyUseWhen",
        "projectUseWhen",
        "gemstonePyStrengths",
        "projectStrengths",
        "remaining",
        "nextBatch",
        "topGap"
      ],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "gemstonePyUseWhen": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "projectUseWhen": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "gemstonePyStrengths": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "projectStrengths": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "remaining": {
          "$ref": "#/$defs/remaining"
        },
        "nextBatch": {
          "$ref": "#/$defs/batch"
        },
        "topGap": {
          "$ref": "#/$defs/genericGap"
        }
      }
    },
    "parityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "project", "overall", "rows"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "overall": {
          "$ref": "#/$defs/parityOverall"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/parityRow"
          }
        }
      }
    },
    "gapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "gaps"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comparisonGap"
          }
        }
      }
    },
    "nextEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "batch", "gap"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "batch": {
          "$ref": "#/$defs/batch"
        },
        "gap": {
          "$ref": "#/$defs/genericGap"
        }
      }
    },
    "totalsEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "totalBatches", "hoursMin", "hoursMax"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "totalBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMin": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMax": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "batchEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "totalBatches", "hoursMin", "hoursMax", "batches"],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/comparisonName"
        },
        "totalBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMin": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMax": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "batches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/batch"
          }
        }
      }
    },
    "summaryRow": {
      "oneOf": [
        {
          "$ref": "#/$defs/gemstoneRsRow"
        },
        {
          "$ref": "#/$defs/gemstoneJsRow"
        }
      ]
    },
    "parityOverall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gemstonePyScore", "projectScore", "maxScore", "scoreGap"],
      "properties": {
        "gemstonePyScore": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "projectScore": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "maxScore": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "scoreGap": {
          "type": "integer"
        }
      }
    },
    "parityRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "gemstonePyScore",
        "projectScore",
        "leader",
        "status",
        "nextAction"
      ],
      "properties": {
        "area": {
          "type": "string",
          "minLength": 1
        },
        "gemstonePyScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "projectScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "leader": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gemstoneRsRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "gemstonePy", "gemstoneRs", "recommendation"],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "gemstonePy": {
          "type": "string"
        },
        "gemstoneRs": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        }
      }
    },
    "gemstoneJsRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "gemstonePy", "gemstoneJs", "recommendation"],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "gemstonePy": {
          "type": "string"
        },
        "gemstoneJs": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        }
      }
    },
    "comparisonGap": {
      "oneOf": [
        {
          "$ref": "#/$defs/gemstoneRsGap"
        },
        {
          "$ref": "#/$defs/gemstoneJsGap"
        }
      ]
    },
    "gemstoneRsGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "area",
        "gemstonePyStrength",
        "gemstoneRsGap",
        "nextAction",
        "verifyWith"
      ],
      "properties": {
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "gemstonePyStrength": {
          "type": "string"
        },
        "gemstoneRsGap": {
          "type": "string"
        },
        "nextAction": {
          "type": "string"
        },
        "verifyWith": {
          "type": "string"
        }
      }
    },
    "gemstoneJsGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "area",
        "gemstonePyStrength",
        "gemstoneJsGap",
        "nextAction",
        "verifyWith"
      ],
      "properties": {
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "gemstonePyStrength": {
          "type": "string"
        },
        "gemstoneJsGap": {
          "type": "string"
        },
        "nextAction": {
          "type": "string"
        },
        "verifyWith": {
          "type": "string"
        }
      }
    },
    "genericGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "area",
        "gemstonePyStrength",
        "project",
        "projectGap",
        "nextAction",
        "verifyWith"
      ],
      "properties": {
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "gemstonePyStrength": {
          "type": "string"
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "projectGap": {
          "type": "string"
        },
        "nextAction": {
          "type": "string"
        },
        "verifyWith": {
          "type": "string"
        }
      }
    },
    "remaining": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalBatches", "hoursMin", "hoursMax"],
      "properties": {
        "totalBatches": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMin": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMax": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "statusCommands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scorecard", "parity", "batches", "totals"],
      "properties": {
        "scorecard": {
          "type": "string",
          "minLength": 1
        },
        "parity": {
          "type": "string",
          "minLength": 1
        },
        "batches": {
          "type": "string",
          "minLength": 1
        },
        "totals": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "focus", "hoursMin", "hoursMax", "outcome", "verifyWith"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "hoursMin": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hoursMax": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "outcome": {
          "type": "string"
        },
        "verifyWith": {
          "type": "string"
        }
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    }
  }
}
