{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unicompute/gemstone-rs/raw/main/schemas/gemstone-rs.codegen.schema.json",
  "title": "gemstone-rs Codegen Config Model",
  "description": "Structured JSON model for gemstone-rs codegen configs. The CLI still reads the line-oriented gemstone-rs.codegen format; tools can use this schema for equivalent JSON views.",
  "type": "object",
  "additionalProperties": false,
  "required": ["output"],
  "properties": {
    "output": {
      "type": "string",
      "minLength": 1
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/class"
      },
      "default": []
    },
    "mapped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapped"
      },
      "default": []
    }
  },
  "$defs": {
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dictionary": {
          "type": "string",
          "default": ""
        },
        "className": {
          "type": "string"
        },
        "meta": {
          "type": "boolean",
          "default": false
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          },
          "default": []
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector"],
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Argument name. The line-oriented config can also spell this as name:Type."
              },
              {
                "$ref": "#/$defs/argument"
              }
            ]
          },
          "default": []
        },
        "argTypes": {
          "type": "array",
          "items": {
            "enum": ["Oop", "String", "Symbol", "SmallInt", "Bool"]
          },
          "description": "Optional parallel type list for tools that keep names and types separate."
        },
        "return": {
          "enum": ["Value", "Oop", "String", "Symbol", "SmallInt", "Bool"],
          "default": "Value"
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["Oop", "String", "Symbol", "SmallInt", "Bool"],
          "default": "Oop"
        }
      }
    },
    "mapped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "doc": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "default": []
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "key"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "Bridge field type such as String, SmallInt, Bool, Oop, Value, Mapped<CustomerDraft>, Vec<String>, Option<String>, BTreeMap<String, String>, Map<String, String>, or Dictionary<String>."
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "keyType": {
          "enum": ["String", "Symbol"],
          "default": "String"
        },
        "doc": {
          "type": "string"
        }
      }
    }
  }
}
