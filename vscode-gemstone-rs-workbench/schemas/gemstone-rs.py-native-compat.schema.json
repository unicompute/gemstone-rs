{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unicompute/gemstone-rs/raw/main/schemas/gemstone-rs.py-native-compat.schema.json",
  "title": "gemstone-rs py-native Compatibility Output",
  "description": "Machine-readable output from gemstone-rs py-native compatibility --json for the generated Python compatibility shim above the PyO3 native adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "module", "sessionClass", "handleClass", "returnPolicy", "methods"],
  "properties": {
    "contractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "module": {
      "type": "string",
      "const": "gemstone_py_native_compat"
    },
    "sessionClass": {
      "type": "string",
      "const": "NativeCompatibilitySession"
    },
    "handleClass": {
      "type": "string",
      "const": "OopHandle"
    },
    "returnPolicy": {
      "type": "string"
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pythonMethod", "nativeMethod", "nativeReturn", "pythonReturn", "note"],
        "properties": {
          "pythonMethod": {
            "type": "string"
          },
          "nativeMethod": {
            "type": "string"
          },
          "nativeReturn": {
            "type": "string"
          },
          "pythonReturn": {
            "type": "string",
            "enum": ["NativeCompatibilitySession", "OopHandle", "int", "str", "bool", "None"]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
