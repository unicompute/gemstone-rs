    "menus": {
      "view/title": [
        {
          "command": "gemstoneRs.refreshExplorer",
          "when": "view == gemstoneRsExplorer",
          "group": "navigation"
        },
        {
          "command": "gemstoneRs.codegenPreview",
          "when": "view == gemstoneRsExplorer",
          "group": "navigation@2"
        },
        {
          "command": "gemstoneRs.codegenCheck",
          "when": "view == gemstoneRsExplorer",
          "group": "navigation@3"
        },
        {
          "command": "gemstoneRs.codegenExplain",
          "when": "view == gemstoneRsExplorer",
          "group": "navigation@4"
        },
        {
          "command": "gemstoneRs.openCodegenConfig",
          "when": "view == gemstoneRsExplorer",
          "group": "navigation@5"
        },
        {
          "command": "gemstoneRs.openGeneratedOutput",
          "when": "view == gemstoneRsExplorer",
          "group": "navigation@6"
        },
        {
          "command": "gemstoneRs.codegenGenerate",
          "when": "view == gemstoneRsExplorer",
          "group": "navigation@7"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "gemstone-rs.codegen.json",
          "*.gemstone-rs.codegen.json"
        ],
        "url": "./schemas/gemstone-rs.codegen.schema.json"
      },
      {
        "fileMatch": [
          "gemstone-rs.codegen-profiles.json"
        ],
        "url": "./schemas/gemstone-rs.codegen-profiles.schema.json"
      },
      {
        "fileMatch": [
          "gemstone-rs.profile-check.json",
          "*.gemstone-rs.profile-check.json"
        ],
        "url": "./schemas/gemstone-rs.profile-check.schema.json"
      },
      {
        "fileMatch": [
          "gemstone-rs.compare.json",
          "*.gemstone-rs.compare.json"
        ],
        "url": "./schemas/gemstone-rs.compare.schema.json"
      }
    ],
    "configuration": {
      "title": "gemstone-rs Workbench",
      "properties": {
        "gemstoneRs.cliPath": {
          "type": "string",
          "default": "gemstone-rs",
          "description": "Path to the gemstone-rs CLI binary. Ignored when gemstoneRs.useCargo is true."
        },
        "gemstoneRs.explorerPath": {
          "type": "string",
          "default": "gemstone-rs-explorer",
          "description": "Path to the gemstone-rs explorer binary. Ignored when gemstoneRs.useCargo is true."
        },
        "gemstoneRs.checkoutPath": {
          "type": "string",
          "default": "",
          "description": "Optional gemstone-rs checkout path used as working directory and for cargo-based commands."
        },
        "gemstoneRs.useCargo": {
          "type": "boolean",
          "default": false,
          "description": "Run commands through cargo run -p gemstone-rs-cli / gemstone-rs-explorer."
        },
        "gemstoneRs.envFile": {
          "type": "string",
          "default": ".env.gemstone-rs",
          "description": "Optional GemStone environment file. When this file exists, Workbench commands pass --env-file automatically."
        },
        "gemstoneRs.codegenConfig": {
          "type": "string",
          "default": "gemstone-rs.codegen",
          "description": "Default gemstone-rs codegen config path."
        },
        "gemstoneRs.codegenProfiles": {
          "type": "string",
          "default": "gemstone-rs.codegen-profiles.json",
          "description": "Default gemstone-rs project profile JSON path."
        },
        "gemstoneRs.bridgeRoot": {
          "type": "string",
          "default": "GemStoneRsBridgeRoot",
          "description": "Default GemStone global dictionary used by BridgeRoot commands and explorer probes."
        },
        "gemstoneRs.explorerHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host for the local gemstone-rs explorer."
        },
        "gemstoneRs.explorerPort": {
          "type": "number",
          "default": 8787,
          "description": "Port for the local gemstone-rs explorer."
        },
        "gemstoneRs.explorerAuthToken": {
          "type": "string",
          "default": "",
          "description": "Optional local auth token for gemstone-rs-explorer. When set, Workbench launches the explorer with --auth-token and appends token= to explorer URLs."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js",
    "test:smoke": "node scripts/smoke.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
