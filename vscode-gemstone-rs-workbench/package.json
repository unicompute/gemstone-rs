{
  "name": "gemstone-rs-workbench",
  "displayName": "gemstone-rs Workbench",
  "description": "VS Code commands for gemstone-rs CLI, codegen, and local explorer workflows.",
  "version": "0.3.4",
  "publisher": "unicompute",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#c51620",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unicompute/gemstone-rs.git",
    "directory": "vscode-gemstone-rs-workbench"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:gemstoneRsExplorer",
    "onCommand:gemstoneRs.refreshExplorer",
    "onCommand:gemstoneRs.verifySetup",
    "onCommand:gemstoneRs.verifyLiveSetup",
    "onCommand:gemstoneRs.verifyStrictSetup",
