    "onCommand:gemstoneRs.eval",
    "onCommand:gemstoneRs.browseDictionaries",
    "onCommand:gemstoneRs.browseClasses",
    "onCommand:gemstoneRs.showExampleCommands",
    "onCommand:gemstoneRs.codegenInit",
    "onCommand:gemstoneRs.codegenDiscover",
    "onCommand:gemstoneRs.generateMappingConfig",
    "onCommand:gemstoneRs.previewBridgeRoot",
    "onCommand:gemstoneRs.listBridgeRootKeys",
    "onCommand:gemstoneRs.putBridgeRootString",
    "onCommand:gemstoneRs.putBridgeRootSymbol",
    "onCommand:gemstoneRs.putBridgeRootSmallInt",
    "onCommand:gemstoneRs.putBridgeRootBool",
    "onCommand:gemstoneRs.removeBridgeRootKey",
    "onCommand:gemstoneRs.runGeneratedMappingExample",
    "onCommand:gemstoneRs.codegenPreview",
    "onCommand:gemstoneRs.codegenDiff",
    "onCommand:gemstoneRs.codegenCheck",
    "onCommand:gemstoneRs.codegenExplain",
    "onCommand:gemstoneRs.openCodegenConfig",
    "onCommand:gemstoneRs.openProjectProfiles",
    "onCommand:gemstoneRs.openGeneratedOutput",
    "onCommand:gemstoneRs.codegenGenerate",
    "onCommand:gemstoneRs.codegenPreviewProfile",
    "onCommand:gemstoneRs.codegenDiffProfile",
    "onCommand:gemstoneRs.codegenCheckProfile",
    "onCommand:gemstoneRs.codegenExplainProfile",
    "onCommand:gemstoneRs.codegenGenerateProfile",
    "onCommand:gemstoneRs.loadProjectProfiles",
    "onCommand:gemstoneRs.saveProjectProfiles",
    "onCommand:gemstoneRs.exportCodegenProfile",
    "onCommand:gemstoneRs.showSampleProjectProfiles",
    "onCommand:gemstoneRs.createProjectProfiles",
    "onCommand:gemstoneRs.validateProjectProfiles",
    "onCommand:gemstoneRs.listProjectProfiles",
    "onCommand:gemstoneRs.showProjectProfile",
    "onCommand:gemstoneRs.resolveProjectProfile",
    "onCommand:gemstoneRs.checkProjectProfiles",
    "onCommand:gemstoneRs.launchExplorer",
    "onCommand:gemstoneRs.generateExplorerAuthToken",
    "onCommand:gemstoneRs.clearExplorerAuthToken",
    "onCommand:gemstoneRs.openExplorerWebview",
    "onCommand:gemstoneRs.openMethodSource",
    "onCommand:gemstoneRs.openCodegenDocs",
    "onCommand:gemstoneRs.compareGemstonePyStatus",
    "onCommand:gemstoneRs.compareAllStatus"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gemstoneRs",
          "title": "GemStone RS",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "gemstoneRs": [
        {
          "id": "gemstoneRsExplorer",
          "name": "GemStone RS"
        }
      ]
    },
    "commands": [
      {
