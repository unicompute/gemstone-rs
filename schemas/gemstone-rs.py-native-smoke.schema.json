{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unicompute/gemstone-rs/raw/main/schemas/gemstone-rs.py-native-smoke.schema.json",
  "title": "gemstone-rs py-native Smoke Output",
  "description": "Machine-readable output from gemstone-rs py-native smoke --json for gemstone-py-native wrappers, CI, release checks, and editor integrations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "dryRun", "contractVersion", "steps"],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "dryRun": {
      "type": "boolean"
    },
    "contractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ok", "detail"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "capabilities",
              "oop_constants",
              "value_conversion",
              "config_error_mapping",
              "structured_error_mapping",
              "config_from_env",
              "login",
              "eval_3_plus_4",
              "perform_print_string",
              "global_string_round_trip",
              "cleanup",
              "logout"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
